# Copy to `.env` and fill in from your Supabase project settings.
# NEVER prefix a secret with VITE_ — Vite inlines those into the public bundle.

# Client + server (RLS-bound publishable/anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only (bypasses RLS — used after requireAdmin() has verified the caller)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
